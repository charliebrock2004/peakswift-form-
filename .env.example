# Copy to .env for local overrides. Never commit .env.
# Do not put real secrets in this file.

# Postgres connection string. Required on Vercel (Neon or any Postgres).
# Leave unset locally: the app uses an embedded database for preview only.
# That local database is wiped when the dev server restarts, so it is not
# for real client briefs.
DATABASE_URL=

# Server-only Studio setup key. At least 8 characters.
# On Vercel this MUST be set. The app will not accept the local fallback there.
# Locally, when this is empty, the setup key is PEAKSWIFT.
# This value is never sent to the browser.
STUDIO_SETUP_KEY=

# --- Email notifications (server-only; never sent to the browser) ---
# Every completed brief is emailed to PeakSwiftstudio@gmail.com.
# Gmail: SMTP_USER is the Gmail address, SMTP_PASSWORD is a 16-character
# Google App Password (NOT your normal Gmail password).
# Leave these empty and briefs are still saved; their email waits as "pending"
# and is sent once these are set (daily retry, or "Send email notification" in Studio).
SMTP_USER=
SMTP_PASSWORD=

# Optional. Defaults: smtp.gmail.com, port 465, sender = SMTP_USER,
# recipient = PeakSwiftstudio@gmail.com.
SMTP_HOST=
SMTP_PORT=
NOTIFY_FROM=
NOTIFY_TO=

# Optional. Base URL used for the "Open in Studio" link in emails.
# On Vercel the production domain is detected automatically.
APP_BASE_URL=

# Secret for the daily retry job (/api/notify-retry, see vercel.json crons).
# Vercel sends it automatically when set. At least 16 random characters.
CRON_SECRET=
