# Copy to .env for local overrides. Never commit .env.
# Do not put real secrets in this file.

# Postgres connection string. Required on Vercel (Neon or any Postgres).
# Leave unset locally: the app uses an embedded database for preview only.
# That local database is wiped when the dev server restarts, so it is not
# for real client briefs.
DATABASE_URL=

# Server-only Studio setup key. At least 8 characters.
# On Vercel this MUST be set. The app will not accept the local fallback there.
# Locally, when this is empty, the setup key is PEAKSWIFT.
# This value is never sent to the browser.
STUDIO_SETUP_KEY=

# --- Email notifications (server-only; never sent to the browser) ---
# Every submitted brief is emailed to PeakSwiftstudio@gmail.com. The brief is
# always saved first; if email is off or fails it waits as "pending"/"failed"
# in Studio and is retried (daily cron, or "Send email notification").
#
# In Vercel, enable these for BOTH Production and Preview, then redeploy.

# Recommended provider: Resend (https://resend.com). Create the Resend account
# with PeakSwiftstudio@gmail.com, then resend.com/api-keys → Create API key
# (Sending access). Starts with re_. No DNS needed: without a verified domain,
# Resend sends from onboarding@resend.dev to the account's own address.
RESEND_API_KEY=

# Optional. Only after verifying your own domain at resend.com/domains,
# e.g. PeakSwift Enquiries <enquiries@yourdomain.co.uk>.
RESEND_FROM=

# Optional. Defaults to PeakSwiftstudio@gmail.com.
NOTIFY_TO=

# Fallback provider, used only when RESEND_API_KEY is not set: Gmail SMTP.
# SMTP_USER = full Gmail address; SMTP_PASSWORD = 16-character Google App
# Password (2-Step Verification required), not the normal password.
# Note: if SMTP_USER is PeakSwiftstudio@gmail.com, Gmail files the email under
# Sent Mail, not the Inbox.
SMTP_USER=
SMTP_PASSWORD=
# Optional SMTP overrides. Defaults: smtp.gmail.com, 465, sender = SMTP_USER.
SMTP_HOST=
SMTP_PORT=
NOTIFY_FROM=

# Optional. Base URL for the "Open in Studio" link in emails.
# On Vercel the production domain is detected automatically.
APP_BASE_URL=

# Secret for the daily retry job (/api/notify-retry). Vercel sends it
# automatically when set. At least 16 random characters.
CRON_SECRET=
